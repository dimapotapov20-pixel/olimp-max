POSTGRES_DB=olimp
POSTGRES_USER=olimp
POSTGRES_PASSWORD=olimp
POSTGRES_PORT=5432
API_PORT=8000

# Background import: once a day by default. Reduce only while testing locally.
CATALOG_REFRESH_SECONDS=86400
ADMISSION_CRAWLER_LIMIT=100

# For a parser or backend started on the host machine, not inside Compose.
DATABASE_URL=postgresql://olimp:olimp@localhost:5432/olimp
MAX_BOT_TOKEN=replace_with_the_bot_token_from_business.max.ru
